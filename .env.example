# Optional: restrict proxy access to a single known token.
# When set, every request must present this exact Bearer token
# (or x-goog-api-key, for Gemini). Leave empty to accept any token
# and forward it to Replicate as-is.
API_SECRET=

# Server
HOST=0.0.0.0
PORT=8000

# Task store (async vendors)
DB_PATH=tasks.db

# Sync prediction polling (gemini-style vendors)
PREDICT_TIMEOUT=300
POLL_INTERVAL=2

# Replicate client concurrency
MAX_CONCURRENT=2000
API_POOL_SIZE=500
CDN_POOL_SIZE=200

# Cloudflare R2 (or S3-compatible) storage for BFL base64 input_image uploads.
# Leave blank to disable — BFL routes will then reject base64 inputs.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_CUSTOM_DOMAIN=
